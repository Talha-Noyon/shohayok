{
  "name": "shohayok",
  "version": "0.1.0",
  "description": "Local-first support assistant for Bangla, Banglish and English: RAG over MongoDB with open models on one 12 GB GPU.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "eval": "tsx src/cli/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
