# MongoDB. Any MongoDB 6+ works; Atlas or the atlas-local Docker image adds native vector search.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shohayok
# DNS servers for Node's resolver, e.g. 8.8.8.8,1.1.1.1. Set this if a mongodb+srv string
# fails with "querySrv ECONNREFUSED": some Windows setups hand Node a resolver that refuses.
DNS_SERVERS=

# Where answers and the Banglish rewrite run: ollama (local GPU) or openrouter (cloud)
LLM_PROVIDER=ollama
# Where embeddings run. Empty means the same as LLM_PROVIDER.
EMBED_PROVIDER=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434

# OpenRouter. Create a key on openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1

# Models. Empty means the default for the provider:
#   Ollama:     EMBED_MODEL=bge-m3                             CHAT_MODEL=gemma3:12b
#   OpenRouter: EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free  CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Keep to :free models on an account without credit. A paid request pushes the balance below
# zero, and a negative balance blocks the free models too.
EMBED_MODEL=
CHAT_MODEL=
# Optional smaller model for the Banglish rewrite step; defaults to CHAT_MODEL
REWRITE_MODEL=

# auto | atlas | local
VECTOR_BACKEND=auto
# Below this cosine similarity the assistant offers a callback. Empty means the default for the
# embedding model: 0.5 for bge-m3, 0.25 for the free Nemotron embedder.
HANDOFF_THRESHOLD=
TOP_K=4
PORT=3000

# The free models allow 50 requests a day for the whole OpenRouter account. The demo stops at
# DAILY_MODEL_BUDGET, and one visitor at VISITOR_DAILY_BUDGET. Not counted on Ollama.
DAILY_MODEL_BUDGET=45
VISITOR_DAILY_BUDGET=15
# Messages per visitor
RATE_PER_MINUTE=8
RATE_PER_DAY=100
# Key for hashing visitors' IP addresses. Empty means one derived from MONGODB_URI.
HASH_SECRET=
