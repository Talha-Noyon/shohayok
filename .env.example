# MongoDB. Any MongoDB 6+ works; Atlas or the atlas-local Docker image adds native vector search.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shohayok

# Where answers and the Banglish rewrite run: ollama (local GPU) or openrouter (cloud)
LLM_PROVIDER=ollama
# Where embeddings run. Empty means the same as LLM_PROVIDER.
EMBED_PROVIDER=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434

# OpenRouter. Create a key on openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1

# Models. Empty means the default for the provider:
#   Ollama:     EMBED_MODEL=bge-m3        CHAT_MODEL=gemma3:12b
#   OpenRouter: EMBED_MODEL=baai/bge-m3   CHAT_MODEL=google/gemma-4-31b-it:free
# On OpenRouter, baai/bge-m3 costs about $0.01 per million tokens and needs some credit.
# nvidia/nemotron-3.5-embed-1b:free costs nothing but is untested on Bengali.
EMBED_MODEL=
CHAT_MODEL=
# Optional smaller model for the Banglish rewrite step; defaults to CHAT_MODEL
REWRITE_MODEL=

# auto | atlas | local
VECTOR_BACKEND=auto
# Below this cosine similarity the assistant hands off to a human
HANDOFF_THRESHOLD=0.5
TOP_K=4
PORT=3000
